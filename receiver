    {"wifi_quality", "WiFi jakosc sygnalu",  "%",    nullptr,           "measurement",      "diagnostic", false},
    {"ip",           "Adres IP",             nullptr,nullptr,           nullptr,            "diagnostic", true },
    {"ssid",         "Podlaczone SSID",      nullptr,nullptr,           nullptr,            "diagnostic", true },
    {"status",       "Status licznika",      nullptr,nullptr,           nullptr,            "diagnostic", true },
  };

  for (const Ent &e : ents) {
    snprintf(uid, sizeof(uid), "%s_%s", NODE_ID, e.key);
    snprintf(topic, sizeof(topic), "homeassistant/sensor/%s/%s/config", NODE_ID, e.key);

    int n = snprintf(payload, sizeof(payload),
      "{\"name\":\"%s\",\"uniq_id\":\"%s\",\"stat_t\":\"%s\","
      "\"avty_t\":\"%s\",\"val_tpl\":\"{{ value_json.%s }}\",%s",
      e.name, uid, g_stateTopic, g_availTopic, e.key, devStr);

    if (e.unit)       n += snprintf(payload + n, sizeof(payload) - n, ",\"unit_of_meas\":\"%s\"", e.unit);
    if (e.devClass)   n += snprintf(payload + n, sizeof(payload) - n, ",\"dev_cla\":\"%s\"", e.devClass);
    if (e.stateClass) n += snprintf(payload + n, sizeof(payload) - n, ",\"stat_cla\":\"%s\"", e.stateClass);
    if (e.category)   n += snprintf(payload + n, sizeof(payload) - n, ",\"ent_cat\":\"%s\"", e.category);
    snprintf(payload + n, sizeof(payload) - n, "}");

    mqtt.publish(topic, payload, true);
    delay(20);
  }
  Serial.println("MQTT discovery opublikowane");
}

static void mqttPublishState() {
  MeterData d;
  portENTER_CRITICAL(&g_mux);
  d = g_data;
  portEXIT_CRITICAL(&g_mux);

  int rssi = WiFi.RSSI();
  int quality = rssi <= -100 ? 0 : (rssi >= -50 ? 100 : 2 * (rssi + 100));

  char lastSeen[32] = "";
  if (d.last_seen > 0) {
    struct tm tmv;
    gmtime_r(&d.last_seen, &tmv);
    strftime(lastSeen, sizeof(lastSeen), "%Y-%m-%dT%H:%M:%SZ", &tmv);
  }

  char payload[512];
  int n = snprintf(payload, sizeof(payload), "{");
  if (d.valid) {
    n += snprintf(payload + n, sizeof(payload) - n,
      "\"total_m3\":%.3f,\"max_flow\":%.3f,\"meter_rssi\":%d,"
      "\"status\":\"%s\",\"last_seen\":\"%s\",",
      d.total_m3, d.flow_m3h, d.rssi,
      d.status == 0 ? "OK" : "ALARM", lastSeen);
  }
  n += snprintf(payload + n, sizeof(payload) - n,
    "\"wifi_rssi\":%d,\"wifi_quality\":%d,\"ip\":\"%s\",\"ssid\":\"%s\"}",
    rssi, quality, WiFi.localIP().toString().c_str(), WiFi.SSID().c_str());

  mqtt.publish(g_stateTopic, payload, true);
}

static void mqttEnsureConnected() {
  if (mqtt.connected()) return;
  Serial.print("Laczenie z MQTT... ");
  if (mqtt.connect(NODE_ID, MQTT_USER, MQTT_PASS, g_availTopic, 0, true, "offline")) {
    Serial.println("OK");
    mqtt.publish(g_availTopic, "online", true);
    mqttPublishDiscovery();
    mqttPublishState();
  } else {
    Serial.printf("blad rc=%d\n", mqtt.state());
    delay(2000);
  }
}

// ================================ SETUP =====================================

static bool parseHexKey(const char *hex, uint8_t *out, size_t outLen) {
  if (strlen(hex) != outLen * 2) return false;
  for (size_t i = 0; i < outLen; i++) {
    char b[3] = { hex[i * 2], hex[i * 2 + 1], 0 };
    char *end;
    long v = strtol(b, &end, 16);
    if (*end) return false;
    out[i] = (uint8_t)v;
  }
  return true;
}

void setup() {
  Serial.begin(115200);
  delay(300);
  Serial.println("\n=== wM-Bus T1 iPERL -> MQTT ===");

  if (!parseHexKey(METER_KEY_HEX, meterKey, 16)) {
    Serial.println("BLAD: klucz AES musi miec 32 znaki HEX");
  }
  meterIdBin = (uint32_t)strtoul(METER_ID, nullptr, 10);

  snprintf(g_stateTopic, sizeof(g_stateTopic), "wmbus/%s/state", NODE_ID);
  snprintf(g_availTopic, sizeof(g_availTopic), "wmbus/%s/availability", NODE_ID);

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  Serial.print("WiFi");
  while (WiFi.status() != WL_CONNECTED) { delay(400); Serial.print("."); }
  Serial.printf(" OK, IP: %s\n", WiFi.localIP().toString().c_str());

  configTime(0, 0, NTP_SERVER, "pool.ntp.org");

  mqtt.setServer(MQTT_HOST, MQTT_PORT);
  mqtt.setBufferSize(1024);          // wazne: discovery nie zmiesci sie w 256 B

  if (!radioInit()) {
    Serial.println("BLAD: brak komunikacji z SX1276 - sprawdz piny SPI/CS/RESET");
  } else {
    xTaskCreatePinnedToCore(radioTask, "radio", 8192, nullptr, 5, nullptr, 0);
    Serial.println("Odbiornik uruchomiony (T1, 868.95 MHz)");
  }
}

void loop() {
  if (WiFi.status() != WL_CONNECTED) {
    WiFi.reconnect();
    delay(1000);
    return;
  }
  mqttEnsureConnected();
  mqtt.loop();

  static uint32_t lastPub = 0;
  bool fresh = false;

  portENTER_CRITICAL(&g_mux);
  if (g_newTelegram) { g_newTelegram = false; fresh = true; }
  portEXIT_CRITICAL(&g_mux);

  if (fresh || millis() - lastPub > WIFI_PUBLISH_MS) {
    lastPub = millis();
    if (mqtt.connected()) mqttPublishState();
  }

  delay(10);
}
